// 知信 v0.1 — 从来信中识别安排与变化，提出日程更新和回复草稿，确认后执行
// 识别: model.complete 结构化提取 + 规则引擎兜底 | 护栏: 引用必须在原文中逐字出现
// 提案: 同一事项的后续来信更新同一张提案卡 | 授权: 单次确认 / 发件人+动作维度规则
// 执行: 确认后 mail.send 发送回复, 桌面 glance 卡片聚合待办

let account = nil
let messages = []
let proposals = []
let rules = []
let screen = "boot"
let demo_mode = false
let busy = false
let status_text = ""
let current_pid = ""
let edit_draft = ""
let model_seen_ok = false
let mail_seen_ok = false

let ink = #x1c1c1e
let sub = #x8e8e93
let blue = #x007aff
let red = #xd70015
let green = #x34a853
let amber = #xb26a00
let card_bg = #xf7f7f9
let line = #xe5e5ea

// ---------- 工具 ----------

fn contains(s, sub_s) { return s.search(sub_s) >= 0 }

fn first_char(s) {
    let chars = s.split("")
    for c in chars { if c != "" { return c } }
    return "?"
}

fn set_status(t) { status_text = t }

fn save_state() {
    let kept = []
    for p in proposals {
        kept.push({id: p.id last_id: p.last_id topic_key: p.topic_key kind: p.kind title: p.title
            sender: p.sender address: p.address
            old_v: p.old_v new_v: p.new_v quote: p.quote verified: p.verified
            ev_title: p.ev_title ev_date: p.ev_date ev_time: p.ev_time ev_loc: p.ev_loc ev_quote: p.ev_quote
            draft: p.draft reply_to: p.reply_to subject: p.subject
            status: p.status versions: p.versions updated: p.updated
            body: p.body preview: p.preview time_label: p.time_label})
    }
    fs.write("zhixin.json", {rules: rules proposals: kept}.to_json())
}

fn load_state() {
    if fs.exists("zhixin.json") {
        let v = fs.read("zhixin.json").parse_json()
        if v != nil {
            if v.rules != nil { rules = v.rules }
            if v.proposals != nil { proposals = v.proposals }
        }
    }
}

fn find_proposal(pid) {
    for p in proposals { if p.id == pid { return p } }
    return nil
}

fn find_by_topic(tkey) {
    for p in proposals {
        if p.topic_key == tkey && p.status != "done" && p.status != "ignored" { return p }
    }
    return nil
}

fn pending_count() {
    let n = 0
    for p in proposals { if p.status == "pending" { n = n + 1 } }
    return n
}

fn proposal_for_email(eid) {
    for p in proposals { if p.id == eid { return p } }
    for p in proposals { if p.last_id == eid { return p } }
    return nil
}

fn rule_matches(address, kind) {
    for r in rules {
        if r.address == address && r.kind == kind { return true }
    }
    return false
}

