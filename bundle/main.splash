                                Label{padding: 0 text: status_label(p) draw_text.color: status_color(p) draw_text.text_style.font_size: 11}
                            }
                            if p.kind == "order" && p.order_stage != "" {
                                RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3} draw_bg +: {color: page_bg border_radius: 5.0}
                                    Label{padding: 0 text: order_stage_label(p.order_stage) draw_text.color: order_stage_color(p.order_stage) draw_text.text_style.font_size: 11}
                                }
                            }
                            if p.updated {
                                RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3} draw_bg +: {color: warm_bg border_radius: 9.0}
                                    Label{padding: 0 text: "第 " + p.versions + " 次更新" draw_text.color: amber draw_text.text_style.font_size: 11}
                                }
                            }
                        }
                    }
                    }
                }
            }
        }

        // ===== 邮件详情 + 行动卡片 =====
        if screen == "detail" {
            let p = find_proposal(current_pid)
            if p == nil {
                Label{padding: 0 text: "未找到这封邮件" draw_text.color: sub}
            }
            if p != nil {
                ButtonFlat{margin: 0 draw_text.text_style.font_size: 12 text: "← 返回" height: 32 padding: Inset{left: 12 right: 12} on_click: || go_inbox()
                    draw_bg +: {border_radius: 8.0 color: card_bg color_hover: line color_down: line border_size: 0.0}
                    draw_text +: {color: blue color_hover: blue color_down: blue}}
                View{width: Fill height: Fit flow: Down spacing: 4
                    Label{padding: 0 width: Fill text: p.sender + " · " + p.time_label draw_text.color: sub draw_text.text_style.font_size: 12}
                    Label{padding: 0 width: Fill text: engine_label(p) draw_text.color: sub draw_text.text_style.font_size: 11}
                }

                if p.kind == "order" {
                    RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: 14 draw_bg +: {color: card_bg border_radius: 12.0}
                        Label{padding: 0 width: Fill text: "物流追踪 · " + p.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                        if p.order_stage == "" {
                            Label{padding: 0 width: Fill text: "原文未确认物流状态，请核对邮件。" draw_text.color: amber draw_text.text_style.font_size: 12}
                        } else {
                        View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                            View{width: Fill height: Fit flow: Right spacing: 14 align: Align{y: 0.5}
                                View{width: Fit height: Fit flow: Right spacing: 4 align: Align{y: 0.5}
                                    RoundedView{width: 10 height: 10 draw_bg +: {color: green border_radius: 5.0}}
                                    Label{padding: 0 text: "已下单" draw_text.color: green draw_text.text_style.font_size: 12}
                                }
                                View{width: Fit height: Fit flow: Right spacing: 4 align: Align{y: 0.5}
                                    RoundedView{width: 10 height: 10 draw_bg +: {color: step2_color(p.order_stage) border_radius: 5.0}}
                                    Label{padding: 0 text: "运输中" draw_text.color: step2_text_color(p.order_stage) draw_text.text_style.font_size: 12}
                                }
                                View{width: Fit height: Fit flow: Right spacing: 4 align: Align{y: 0.5}
                                    RoundedView{width: 10 height: 10 draw_bg +: {color: step3_color(p.order_stage) border_radius: 5.0}}
                                    Label{padding: 0 text: "已送达" draw_text.color: step3_text_color(p.order_stage) draw_text.text_style.font_size: 12}
                                }
                            }
                        }
                        }
                        if p.order_no != "" {
                            Label{padding: 0 width: Fill text: "订单号 " + p.order_no + " · 运单号 " + p.tracking + " · " + p.eta
                                draw_text.color: sub draw_text.text_style.font_size: 12}
                        }
                        let number_quote = text_field(p, "order_no_quote", "")
                        let tracking_quote = text_field(p, "tracking_quote", "")
                        if number_quote != "" && number_quote != p.quote {
                            Label{padding: 0 width: Fill text: "订单号来源（此前原文）\n「" + number_quote + "」" draw_text.color: sub draw_text.text_style.font_size: 11}
                        }
                        if tracking_quote != "" && tracking_quote != p.quote && tracking_quote != number_quote {
                            Label{padding: 0 width: Fill text: "运单号来源（此前原文）\n「" + tracking_quote + "」" draw_text.color: sub draw_text.text_style.font_size: 11}
                        }
                        if p.quote != "" {
                            Label{padding: 0 width: Fill text: "来源 · 「" + p.quote + "」" draw_text.color: sub draw_text.text_style.font_size: 11}
                        }
                        if p.versions > 1 {
                            Label{padding: 0 width: Fill text: "后续物流邮件已更新同一份追踪（第 " + p.versions + " 次更新）" draw_text.color: amber draw_text.text_style.font_size: 12}
                        }
                        if !p.verified {
                            Label{padding: 0 width: Fill text: "部分物流字段未能在原文中逐字核对，已隐藏；请展开原文确认" draw_text.color: red draw_text.text_style.font_size: 12}
                        }
                    }
                }

                if p.kind == "other" || (p.status == "info" && p.kind != "order") {
                    RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: 14 draw_bg +: {color: card_bg border_radius: 12.0}
                        Label{padding: 0 width: Fill text: "识别结果：" + kind_label(p.kind) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                        Label{padding: 0 width: Fill text: "这封来信没有需要你确认的安排或回复。" draw_text.color: sub draw_text.text_style.font_size: 13}
                    }
                }

                if p.kind == "schedule_change" || p.kind == "new_event" || p.kind == "reply_request" {
                    // 变更 / 日程卡片
                    RoundedView{width: Fill height: Fit flow: Down spacing: 10 padding: 14 draw_bg +: {color: card_bg border_radius: 10.0 border_size: 1.0 border_color: line}
                        Label{padding: 0 width: Fill text: kind_label(p.kind) + " · " + p.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                        if p.old_v != "" && p.new_v != "" {
                            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                RoundedView{width: Fill height: Fit flow: Down spacing: 5 padding: 10 draw_bg +: {color: page_bg border_radius: 7.0}
                                    Label{padding: 0 width: Fill text: "原安排" draw_text.color: sub draw_text.text_style.font_size: 10}
                                    Label{padding: 0 width: Fill text: arrangement_lines(p.old_v) draw_text.color: sub draw_text.text_style.font_size: 14}
                                }
                                Label{padding: 0 text: "→" draw_text.color: sub draw_text.text_style.font_size: 14}
                                RoundedView{width: Fill height: Fit flow: Down spacing: 5 padding: 10 draw_bg +: {color: blue_bg border_radius: 7.0}
                                    Label{padding: 0 width: Fill text: "新安排" draw_text.color: blue draw_text.text_style.font_size: 10}
                                    Label{padding: 0 width: Fill text: arrangement_lines(p.new_v) draw_text.color: blue draw_text.text_style: theme.font_bold{font_size: 14}}
                                }
                            }
                        }
                        if p.ev_title != "" {
                            Label{padding: 0 width: Fill text: p.ev_title + " · " + p.ev_date + " " + p.ev_time + " · " + p.ev_loc
                                draw_text.color: ink draw_text.text_style.font_size: 14}
                        }
                        if p.quote != "" {
                            View{width: Fill height: Fit flow: Down spacing: 3 padding: Inset{top: 4}
                                Label{padding: 0 width: Fill text: "来源 · 邮件原文" draw_text.color: sub draw_text.text_style.font_size: 11}
                                Label{padding: 0 width: Fill text: "「" + p.quote + "」" draw_text.color: sub draw_text.text_style.font_size: 12}
                            }
                        }
                        if !p.verified {
                            Label{padding: 0 width: Fill text: "未能在原文中逐字核对该变化，请以原文为准" draw_text.color: red draw_text.text_style.font_size: 12}
                        }
                        if p.versions > 1 {
                            Label{padding: 0 width: Fill text: "第 " + p.versions + " 次更新 · 已替换上一版提案" draw_text.color: amber draw_text.text_style.font_size: 12}
                        }
                        if event_match_label(p) != "" {
                            Label{padding: 0 width: Fill text: event_match_label(p) draw_text.color: blue draw_text.text_style.font_size: 12}
                        }
                    }

                    if p.status == "pending" {
                        let displayed_version = p.versions
                        let displayed_message = p.last_id
                        // 回复草稿
                        View{width: Fill height: Fit flow: Down spacing: 6
                            Label{padding: 0 width: Fill text: "回复草稿" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                            Label{padding: 0 width: Fill text: "收件人 · " + p.reply_to draw_text.color: sub draw_text.text_style.font_size: 12}
                            if p.review_note != "" {
                                Label{padding: 0 width: Fill text: p.review_note draw_text.color: amber draw_text.text_style.font_size: 12}
                            }
                            draft_input := TextInput{width: Fill height: 88 is_multiline: true flow: Flow.Right{wrap: true} text: edit_draft on_change: |text| { update_draft(p.id, displayed_version, displayed_message, text) }
                                padding: 12 draw_text.text_style.font_size: 13
                                draw_bg +: {color: card_bg color_hover: card_bg color_focus: #xffffff border_radius: 8.0}
                                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: sub color_empty_hover: sub}}
                        }
                        if reviewing_pid == "" {
                        ButtonFlat{margin: 0 draw_text.text_style.font_size: 12 text: send_button_text() width: Fill height: 46 on_click: || execute_proposal(current_pid, false)
                            draw_bg +: {border_radius: 8.0 color: blue color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
                            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
                        View{width: Fill height: Fit flow: Right spacing: 8
                            ButtonFlat{margin: 0 draw_text.text_style.font_size: 12 text: "记住规则并审阅" width: Fill height: 40 on_click: || add_rule_for(current_pid)
                                draw_bg +: {border_radius: 8.0 color: card_bg color_hover: line color_down: line border_size: 0.0}
                                draw_text +: {color: blue color_hover: blue color_down: blue}}
                            ButtonFlat{margin: 0 draw_text.text_style.font_size: 12 text: "忽略" width: Fill height: 40 on_click: || ignore_proposal(current_pid)
                                draw_bg +: {border_radius: 8.0 color: card_bg color_hover: line color_down: line border_size: 0.0}
                                draw_text +: {color: sub color_hover: sub color_down: sub}}
                        }
                        Label{padding: 0 width: Fill text: "规则仅为 " + p.address + " 的「" + kind_label(p.kind) + "」准备草稿；每次发送仍需宿主审阅，可随时撤销规则"
                            draw_text.color: sub draw_text.text_style.font_size: 11}
                        } else {
                            Label{padding: 0 width: Fill text: "正在宿主审阅，请在宿主批准或取消。提案会保留到结果明确。" draw_text.color: blue draw_text.text_style.font_size: 13}
                        }
                    }
                    if p.status == "done" || p.status == "auto" {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: 14 draw_bg +: {color: success_bg border_radius: 12.0}
                            Label{padding: 0 width: Fill text: "✓ " + status_label(p) draw_text.color: green draw_text.text_style: theme.font_bold{font_size: 15}}
                            if demo_mode {
                                Label{padding: 0 width: Fill text: "演示回复（未发送）：" draw_text.color: sub draw_text.text_style.font_size: 12}
                            } else {
                                Label{padding: 0 width: Fill text: "发送记录 · 收件人 " + p.reply_to + "（不代表已送达）：" draw_text.color: sub draw_text.text_style.font_size: 12}
                            }
                            Label{padding: 0 width: Fill text: p.draft draw_text.color: ink draw_text.text_style.font_size: 13}
                        }
                        ButtonFlat{margin: 0 draw_text.text_style.font_size: 12 text: "重新处理（不会撤回已发邮件）" width: Fill height: 40 on_click: || reopen_proposal(current_pid)
                            draw_bg +: {border_radius: 8.0 color: card_bg color_hover: line color_down: line border_size: 0.0}
                            draw_text +: {color: sub color_hover: sub color_down: sub}}
                    }
                    if p.status == "ignored" {
                        RoundedView{width: Fill height: Fit padding: 14 draw_bg +: {color: card_bg border_radius: 12.0}
                            Label{padding: 0 width: Fill text: "已忽略 · 邮件仍保留在收件箱" draw_text.color: sub draw_text.text_style.font_size: 14}
                        }
                        ButtonFlat{margin: 0 draw_text.text_style.font_size: 12 text: "恢复为待确认" width: Fill height: 40 on_click: || reopen_proposal(current_pid)
                            draw_bg +: {border_radius: 8.0 color: card_bg color_hover: line color_down: line border_size: 0.0}
                            draw_text +: {color: blue color_hover: blue color_down: blue}}
                    }
                }
                ButtonFlat{margin: 0 draw_text.text_style.font_size: 12 text: original_button_text() width: Fill height: 36 on_click: || { show_original = !show_original refresh_all() }
                    draw_bg +: {border_radius: 8.0 color: card_bg color_hover: line color_down: line border_size: 0.0}
                    draw_text +: {color: blue color_hover: blue color_down: blue}}
                if show_original {
                    for draft in field_value(p, "saved_drafts", []) {
                        RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: 12 draw_bg +: {color: card_bg border_radius: 10.0}
                            Label{padding: 0 width: Fill text: "合并前保存的草稿 · " + draft.subject draw_text.color: sub draw_text.text_style.font_size: 12}
                            Label{padding: 0 width: Fill text: draft.body draw_text.color: ink draw_text.text_style.font_size: 13}
                        }
                    }
                    RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: 12 draw_bg +: {color: card_bg border_radius: 10.0}
                        Label{padding: 0 width: Fill text: "邮件原文 · " + p.subject draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                        Label{padding: 0 width: Fill text: p.body draw_text.color: ink draw_text.text_style.font_size: 13}
                    }
                }
            }
        }

        // ===== 待办看板 =====
        if screen == "board" {
            let n = pending_count()
            View{width: Fill height: Fit flow: Down spacing: 5
                Label{padding: 0 width: Fill text: "接下来要做的事" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
                Label{padding: 0 width: Fill text: n + " 件事待确认 · 看清安排，再回复" draw_text.color: sub draw_text.text_style.font_size: 12}
            }
            if n == 0 {
                RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: 20 draw_bg +: {color: card_bg border_radius: 10.0}
                    Label{padding: 0 width: Fill text: "安排都理清了" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                    Label{padding: 0 width: Fill text: "有新的变化时，会在这里等你确认。" draw_text.color: sub draw_text.text_style.font_size: 12}
                }
            }
            for p in proposals {
                if p.status == "pending" {
                    GestureView{width: Fill height: Fit on_tap: |x, y| open_detail(p.id)
                        RoundedView{width: Fill height: Fit flow: Down spacing: 9 padding: 14 draw_bg +: {color: card_bg border_radius: 10.0 border_size: 1.0 border_color: line}
                            View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                                Label{padding: 0 width: Fill text: p.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                                Label{padding: 0 text: p.time_label draw_text.color: sub draw_text.text_style.font_size: 11}
                            }
                            Label{padding: 0 width: Fill text: p.sender + " · " + kind_label(p.kind) draw_text.color: sub draw_text.text_style.font_size: 12}
                            if p.old_v != "" && p.new_v != "" {
                                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                    Label{padding: 0 width: Fill text: "原 " + arrangement_lines(p.old_v) draw_text.color: sub draw_text.text_style.font_size: 13}
                                    Label{padding: 0 text: "→" draw_text.color: sub draw_text.text_style.font_size: 14}
                                    Label{padding: 0 width: Fill text: "新 " + arrangement_lines(p.new_v) draw_text.color: blue draw_text.text_style: theme.font_bold{font_size: 13}}
                                }
                            }
                            Label{padding: 0 width: Fill text: "查看提案与回复 →" draw_text.color: blue draw_text.text_style.font_size: 11}
                            if p.updated {
                                Label{padding: 0 width: Fill text: "第 " + p.versions + " 次更新 · 提案已按新来信调整" draw_text.color: amber draw_text.text_style.font_size: 12}
                            }
                        }
                    }
                }
            }
        }

        // ===== 日程板: 已确认的安排, 按事项去重合并 =====
        if screen == "calendar" {
            Label{padding: 0 width: Fill text: "已经确认的安排" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
            Label{padding: 0 width: Fill text: "应用内日程板 · 记录你已确认的安排，不代表写入系统日历。"
                draw_text.color: sub draw_text.text_style.font_size: 12}
            if events.len() == 0 {
                RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: 20 draw_bg +: {color: card_bg border_radius: 10.0}
                    Label{padding: 0 width: Fill text: "下一段安排，从这里开始" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    Label{padding: 0 width: Fill text: "确认一封日程来信后，会记在这里。" draw_text.color: sub draw_text.text_style.font_size: 12}
                }
            }
            for e in events {
                RoundedView{width: Fill height: Fit flow: Down spacing: 5 padding: 14 draw_bg +: {color: success_bg border_radius: 12.0}
                    Label{padding: 0 width: Fill text: e.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    Label{padding: 0 width: Fill text: e.detail draw_text.color: ink draw_text.text_style.font_size: 13}
                    if e.versions > 1 {
                        Label{padding: 0 width: Fill text: "已更新 " + e.versions + " 次" draw_text.color: amber draw_text.text_style.font_size: 11}
                    }
                }
            }
        }

        if screen == "history" {
            Label{padding: 0 width: Fill text: "发送记录" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
            Label{padding: 0 width: Fill text: "只记录宿主明确接受的真实提交；不是送达证明。演示操作不计入。" draw_text.color: sub draw_text.text_style.font_size: 12}
            if sent_replies.len() == 0 {
                RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: 20 draw_bg +: {color: card_bg border_radius: 10.0}
                    Label{padding: 0 width: Fill text: "暂无真实发送记录" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    Label{padding: 0 width: Fill text: "每一次获宿主接受的回复，都会记在这里。" draw_text.color: sub draw_text.text_style.font_size: 12}
                }
            }
            for i in sent_replies.len() {
                let r = sent_replies[sent_replies.len() - 1 - i]
                RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: 14 draw_bg +: {color: success_bg border_radius: 12.0}
                    Label{padding: 0 width: Fill text: r.title + " · 第 " + r.version + " 版回复" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    Label{padding: 0 width: Fill text: "收件人 · " + r.reply_to draw_text.color: sub draw_text.text_style.font_size: 12}
                    Label{padding: 0 width: Fill text: r.body draw_text.color: ink draw_text.text_style.font_size: 13}
                    Label{padding: 0 width: Fill text: "宿主已接受提交 · 请在收件方核对送达" draw_text.color: green draw_text.text_style.font_size: 12}
                }
            }
        }

        // ===== 授权规则 =====
        if screen == "rules" {
            Label{padding: 0 width: Fill text: "你记住的规则" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
            Label{padding: 0 width: Fill text: "按发件人和动作准备草稿。每次发送仍需你在宿主审阅，可随时撤销。"
                draw_text.color: sub draw_text.text_style.font_size: 12}
            if rules.len() == 0 {
                Label{padding: 0 width: Fill text: "还没有授权规则" draw_text.color: sub}
            }
            for i in rules.len() {
                let r = rules[i]
                RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: 14 draw_bg +: {color: card_bg border_radius: 12.0}
                    Label{padding: 0 width: Fill text: r.sender + " · " + r.address draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                    Label{padding: 0 width: Fill text: "动作：" + kind_label(r.kind) + " → 准备草稿，待宿主审阅" draw_text.color: sub draw_text.text_style.font_size: 12}
                    ButtonFlat{margin: 0 draw_text.text_style.font_size: 12 text: "撤销这条规则" height: 34 padding: Inset{left: 12 right: 12} on_click: || revoke_rule(i)
                        draw_bg +: {border_radius: 8.0 color: #xffffff color_hover: line color_down: line border_size: 0.0}
                        draw_text +: {color: red color_hover: red color_down: red}}
                }
            }
            if pending_count() > 0 {
                Label{padding: 0 width: Fill text: "提示：撤销规则不影响已完成的回复，只影响之后来信的处理方式。" draw_text.color: sub draw_text.text_style.font_size: 12}
            }
        }
        if glance_status != "" && screen != "detail" {
            Label{padding: 0 width: Fill text: glance_status draw_text.color: amber draw_text.text_style.font_size: 11}
        }
    }}
}
