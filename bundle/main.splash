// 知信 v0.3.8 — 从来信中识别安排与变化，提出日程更新和回复草稿，审阅后执行
// 识别: model.complete 结构化提取 + 规则引擎兜底 | 护栏: 引用必须在原文中逐字出现
// 提案: 同一事项的后续来信更新同一张提案卡 | 授权: 单次确认 / 发件人+动作维度规则
// 执行: mail.review_send 交给宿主审阅; accepted 回执后完成, 桌面 glance 聚合待办

use mod.std.regex

let account = nil
let messages = []
let proposals = []
let rules = []
let events = []
let screen = "boot"
let demo_mode = false
let busy = false
let status_text = ""
let current_pid = ""
let edit_draft = ""
let model_seen_ok = false
let mail_seen_ok = false
let mail_read_failures = 0
let sync_models = 0
let sync_rules = 0
let sync_cached = 0
let sync_model_failures = 0
let connection_model_status = "尚未检查模型服务"
let connection_send_status = "尚未验证真实发送"
let connection_model_busy = false
let reviewing_pid = ""
let glance_status = ""
let storage_notice = ""
let sent_replies = []
let show_original = false
let demo_staged = false
let demo_stage = 0

let ink = #x343e3a
let sub = #x686b64
let blue = #x486c9c
let red = #xd70015
let green = #x456b52
let amber = #x896027
let card_bg = #xfffdf8
let line = #xe5dfd4
let page_bg = #xf6f3ed
let blue_bg = #xeaf0f5
let warm_bg = #xf4ead6
let success_bg = #xedf3ec

// ---------- 工具 ----------

fn contains(s, sub_s) { return s.search(sub_s) >= 0 }

fn first_char(s) {
    let chars = s.split("")
    for c in chars { if c != "" { return c } }
    return "?"
}

// 日期与时间分行展示，窄窗口也不把 15:20 拆成半截；保留提案的原始值。
fn arrangement_lines(value) {
    let shown = ""
    for part in value.split(" ") {
        if part != "" {
            if shown != "" { shown = shown + "\n" }
            shown = shown + part
        }
    }
    return shown
}

fn set_status(t) { status_text = t }

// 可选字段缺失不是 nil；还需拒绝错误类型，避免不完整模型/存储对象打断界面。
fn field_value(obj, name, fallback) {
    if obj == nil { return fallback }
    if obj.to_json().search("{") != 0 { return fallback }
    for key value in obj { if ("" + key) == name { return value } }
    return fallback
}

fn text_field(obj, name, fallback) {
    let value = field_value(obj, name, fallback)
    if value == nil || value.to_json().search("\"") != 0 { return fallback }
    return value
}

fn state_path() {
    if demo_mode { return "zhixin-demo-v1.json" }
    if account == nil { return "" }
    return "zhixin-account-" + account.id.url_encode() + ".json"
}

fn save_state() {
    let path = state_path()
    if path == "" { return }
    let kept = []
    for p in proposals {
        kept.push({id: p.id last_id: p.last_id message_ids: field_value(p, "message_ids", [p.id p.last_id]) topic_key: p.topic_key kind: p.kind title: p.title
            sender: p.sender address: p.address
            old_v: p.old_v new_v: p.new_v quote: p.quote verified: p.verified
            ev_title: p.ev_title ev_date: p.ev_date ev_time: p.ev_time ev_loc: p.ev_loc ev_quote: p.ev_quote
            draft: p.draft reply_to: p.reply_to subject: p.subject
            status: p.status versions: p.versions updated: p.updated
            body: p.body preview: p.preview time_label: p.time_label
            order_no: p.order_no tracking: p.tracking eta: p.eta order_stage: p.order_stage
            order_no_quote: text_field(p, "order_no_quote", "") tracking_quote: text_field(p, "tracking_quote", "")
            saved_drafts: field_value(p, "saved_drafts", [])
            analysis_revision: field_value(p, "analysis_revision", 0) engine: p.engine receipt_accepted: p.receipt_accepted review_note: p.review_note})
    }
    fs.write(path, {schema: 1 account_id: account.id demo: demo_mode rules: rules proposals: kept events: events sent_replies: sent_replies}.to_json())
}

fn load_state() {
    proposals = [] rules = [] events = [] sent_replies = []
    storage_notice = ""
    let path = state_path()
    if path == "" { return }
    if fs.exists(path) {
        let v = fs.read(path).parse_json()
        if field_value(v, "schema", 0) == 1 && text_field(v, "account_id", "") == account.id && field_value(v, "demo", nil) == demo_mode {
            rules = field_value(v, "rules", [])
            proposals = field_value(v, "proposals", [])
            events = field_value(v, "events", [])
            sent_replies = field_value(v, "sent_replies", [])
        } else {
            storage_notice = "本地状态格式或邮箱不匹配，请重新同步；原文件已保留"
        }
    } else if !demo_mode && fs.exists("zhixin.json") {
        storage_notice = "旧版状态未绑定邮箱，原文件已保留；请重新同步来信"
    }
    migrate_rule_records()
    return nil
}

fn migrate_rule_records() {
    for p in proposals {
        if p.engine == "rules" && field_value(p, "analysis_revision", 0) != 1 {
            let a = rule_analyze({subject: p.subject body: p.body address: p.address})
            p.order_stage = ""
            apply_analysis(p, a)
            if p.status == "pending" && !a.reply_needed { p.status = "info" }
            if p.status == "info" && a.reply_needed { p.status = "pending" }
        }
    }
    return nil
}

// 仅在宿主新到旧快照能证明先后时合并旧规则卡；缺失历史不猜顺序。
fn inbox_position(eid) {
    let i = 0
    for m in messages { if m.id == eid { return i } i = i + 1 }
    return -1
}

fn duplicate_rule_index(cards, p) {
    let i = 0
    for q in cards { if q.engine == "rules" && q.topic_key == p.topic_key { return i } i = i + 1 }
    return -1
}

fn has_message_id(ids, eid) {
    for id in ids { if id == eid { return true } }
    return false
}

fn preserve_merged_record(winner, prior) {
    let seen = field_value(winner, "message_ids", [winner.id winner.last_id])
    for eid in field_value(prior, "message_ids", [prior.id prior.last_id]) { if !has_message_id(seen, eid) { seen.push(eid) } }
    winner.message_ids = seen
    let drafts = field_value(winner, "saved_drafts", [])
    for draft in field_value(prior, "saved_drafts", []) { drafts.push(draft) }
    if prior.draft != "" && prior.draft != winner.draft { drafts.push({subject: prior.subject body: prior.draft}) }
    winner.saved_drafts = drafts
    winner.versions = winner.versions + prior.versions
    winner.updated = true
    if current_pid == prior.id { current_pid = winner.id edit_draft = winner.draft }
}

fn reconcile_rule_topics() {
    let merged = []
    for p in proposals {
        let idx = -1
        if p.engine == "rules" { idx = duplicate_rule_index(merged, p) }
        if idx < 0 { merged.push(p) } else {
            let prior = merged[idx]
            let prior_pos = inbox_position(prior.last_id)
            let pos = inbox_position(p.last_id)
            if pos < 0 || prior_pos < 0 {
                merged.push(p)
                storage_notice = "旧主题重复且来源不在当前收件列表，请分别核对；已保留草稿"
            } else if pos < prior_pos {
                preserve_merged_record(p, prior)
                merged[idx] = p
            } else { preserve_merged_record(prior, p) }
        }
    }
    proposals = merged
    save_state()
    return nil
}

fn find_proposal(pid) {
    for p in proposals { if p.id == pid { return p } }
    return nil
}

fn find_by_topic(tkey) {
    for p in proposals {
        if p.topic_key == tkey { return p }
    }
    return nil
}

fn pending_count() {
    let n = 0
    for p in proposals { if p.status == "pending" { n = n + 1 } }
    return n
}

fn proposal_for_email(eid) {
    for p in proposals {
        if p.id == eid || p.last_id == eid { return p }
        for seen in field_value(p, "message_ids", []) { if seen == eid { return p } }
    }
    return nil
}

fn rule_matches(address, kind) {
    for r in rules {
        if r.address == address && r.kind == kind { return true }
    }
    return false
}

